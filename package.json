{
  "name": "spotify-transferrer",
  "version": "1.0.0",
  "description": "Spotify Liked Songs Transferrer - Hybrid Web & Electron App",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "electron-dev": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.spotifytransferrer.app",
    "productName": "Spotify Transferrer",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1"
  }
}
